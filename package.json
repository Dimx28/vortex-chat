{
  "name": "vortex-chat",
  "version": "1.0.1",
  "description": "Vortex Chat — App de escritorio para chatear con Claude u otros proveedores (API propia)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir"
  },
  "author": "Estarling Javier Guzmán Díaz",
  "license": "ISC",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.estarling.vortexchat",
    "productName": "Vortex Chat",
    "icon": "build/icon.ico",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "plugins/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Vortex Chat"
    },
    "publish": {
      "provider": "github",
      "owner": "Dimx28",
      "repo": "vortex-chat"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
